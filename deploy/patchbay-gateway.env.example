# Example environment file for deploy/patchbay-gateway.service.
# Copy to /etc/patchbay-gateway.env, chmod 600, and replace every REPLACE_ME.
PORT=3663
ENABLE_ADMIN_UI=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD=REPLACE_ME
SESSION_SECRET=REPLACE_ME
# Comma-separated static client credentials (Bearer token / X-API-Key or ?key=)
ALLOWED_TOKENS=REPLACE_ME
ALLOWED_KEYS=REPLACE_ME

# Name shown in the admin UI and used as the default server name in generated
# client configs and installers (default: patchbay).
GATEWAY_CLIENT_NAME=patchbay
# Optional accent color for the admin UI header.
#GATEWAY_UI_COLOR=#4f46e5

# Paths. Defaults shown; set them explicitly to keep a different layout.
#MCP_AUDIT_DIR=/var/log/patchbay-gateway/audit
#INSTALLER_BASE_DIR=/opt/patchbay-installer-base
#SSH_PUBLIC_KEY_PATH=<service user's home>/.ssh/id_ed25519.pub

# Admin cookie: NODE_ENV=production marks it Secure, which only works when the
# admin UI is served over HTTPS. Leave unset for plain HTTP on a trusted network.
#NODE_ENV=production
