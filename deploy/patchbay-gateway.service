# Example systemd unit for a native install. Adjust paths to your layout.
[Unit]
Description=Patchbay Gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=/etc/patchbay-gateway.env
WorkingDirectory=/opt/patchbay-gateway
ExecStart=/usr/bin/node /opt/patchbay-gateway/build/sse.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
